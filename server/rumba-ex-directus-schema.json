  "x_rumba_ex_permissions": {
    "notes": [
      "The Directus schema snapshot above is applied through /schema/diff then /schema/apply.",
      "Permissions are intentionally applied separately by rumba-ex-directus-setup.sh because Directus schema snapshots do not carry access rules.",
      "The web app does not expose Directus auth to the browser for profiles. The Node BFF reads the pli_session cookie and filters rumba_ex_profiles by public_user_id.",
      "The Public policy receives create-only access to rumba_ex_events and read-only access to rumba_ex_exercises_meta.",
      "Admin users keep access through Directus admin_access and do not need explicit rumba_ex_events read permissions."
    ],
    "policies": {
      "authenticated": "RUMBA.EX Authenticated User Policy",
      "service": "RUMBA.EX ML Pipeline Service Policy",
      "public": "Directus public policy discovered via directus_access where role and user are null"
    },
    "permission_rules": [
      {
        "audience": "website_bff",
        "collection": "rumba_ex_profiles",
        "actions": [
          "create",
          "read",
          "update",
          "delete"
        ],
        "owner_filter": {
          "public_user_id": {
            "_eq": "$PLI_SESSION_USER"
          }
        }
      },
      {
        "audience": "authenticated",
        "collection": "rumba_ex_recommendation_history",
        "actions": [
          "create",
          "read",
          "delete"
        ],
        "owner_filter": {
          "profile_id": {
            "user_created": {
              "_eq": "$CURRENT_USER"
            }
          }
        }
      },
      {
        "audience": "public",
        "collection": "rumba_ex_events",
        "actions": [
          "create"
        ],
        "write_only": true
      },
      {
        "audience": "public",
        "collection": "rumba_ex_exercises_meta",
        "actions": [
          "read"
        ],
        "read_only": true
      },
      {
        "audience": "authenticated",
        "collection": "rumba_ex_exercises_meta",
        "actions": [
          "read"
        ],
        "read_only": true
      },
      {
        "audience": "service",
